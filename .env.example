# ==========================================
# BINARY.BITE - Cloud Database Configuration
# ==========================================
# Opsi 1: Google Firebase Realtime Database (Disarankan & 100% Gratis)
# Buat project di https://console.firebase.google.com -> Realtime Database -> Create Database.
# Masukkan URL database Firebase di bawah ini:
# Contoh: https://binary-bite-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Opsi 2: Default Server / Local Store
# Jika FIREBASE_DATABASE_URL dikosongkan, sistem otomatis menggunakan server API Next.js internal (/api/orders)
# dengan sinkronisasi penyimpanan persisten data/orders.json.
